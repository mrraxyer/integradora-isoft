# DATABASE
DB_NAME=ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=change_this_strong_password

# BACKEND
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://ecommerce_user:change_this_strong_password@postgres:5432/ecommerce
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=https://yourdomain.com

# Admin Seed (created on startup if vars set)
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change_this_admin_password

# FRONTEND
VITE_API_URL=https://yourdomain.com/api
VITE_APP_NAME=Ecommerce
