# DATABASE CONFIGURATION
DATABASE_URL=postgresql://ecommerce_user:ecommerce_pass@localhost:5432/ecommerce

# BACKEND (Express.js)
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Admin Seed (created on startup if vars set)
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=admin123456

# FRONTEND (React/Vite)
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=Ecommerce
